{
    // The pipeline scripts, the specs and the configs. The apps' sources are
    // type-checked by their own build, against the installed tarballs.
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"],
        "resolveJsonModule": true
    },
    "include": [
        "scripts",
        "specs",
        "playwright.config.ts",
        "vitest.config.ts",
        "apps/*/vite.config.ts"
    ]
}
