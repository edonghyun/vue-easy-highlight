{
    "name": "overlapmark-acceptance-svelte",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vite build",
        "build:ssr": "vite build --mode ssr && vite build --mode ssr --ssr src/entry-server.ts && node --experimental-strip-types ../../scripts/ssr-build.ts"
    },
    "dependencies": {
        "@overlapmark/core": "*",
        "@overlapmark/svelte": "*",
        "svelte": "5.57.2"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "svelte-check": "4.7.7",
        "typescript": "6.0.3",
        "vite": "8.3.5"
    }
}
