{
    "name": "@overlapmark/vue",
    "version": "0.0.0",
    "description": "Vue 3 component for overlapping text highlights",
    "license": "MIT",
    "author": "Donghyun Lee",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/edonghyun/vue-easy-highlight.git",
        "directory": "packages/vue"
    },
    "homepage": "https://github.com/edonghyun/vue-easy-highlight#readme",
    "bugs": "https://github.com/edonghyun/vue-easy-highlight/issues",
    "keywords": [
        "highlight",
        "overlapping-highlights",
        "text-highlight",
        "annotation",
        "vue"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@overlapmark/core": "workspace:^"
    },
    "peerDependencies": {
        "vue": ">=3.3"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run --project node --project browser",
        "typecheck": "tsc --noEmit",
        "prepack": "cp ../../LICENSE LICENSE"
    },
    "devDependencies": {
        "@overlapmark/adapter-contract": "workspace:*",
        "vue": "^3.5.0",
        "vue-3.3-runtime-dom": "npm:@vue/runtime-dom@3.3.13",
        "vue-3.4-runtime-dom": "npm:@vue/runtime-dom@3.4.38",
        "vue-3.5.0-runtime-dom": "npm:@vue/runtime-dom@3.5.0"
    }
}
