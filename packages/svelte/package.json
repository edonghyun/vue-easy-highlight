{
    "name": "@overlapmark/svelte",
    "version": "0.0.0",
    "description": "Svelte 5 component for overlapping text highlights",
    "license": "MIT",
    "author": "Donghyun Lee",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/edonghyun/vue-easy-highlight.git",
        "directory": "packages/svelte"
    },
    "homepage": "https://github.com/edonghyun/vue-easy-highlight#readme",
    "bugs": "https://github.com/edonghyun/vue-easy-highlight/issues",
    "keywords": [
        "highlight",
        "overlapping-highlights",
        "text-highlight",
        "annotation",
        "svelte"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@overlapmark/core": "workspace:^"
    },
    "peerDependencies": {
        "svelte": ">=5"
    },
    "scripts": {
        "build": "svelte-package && cp dist/Highlighter.svelte.d.ts dist/Highlighter.d.svelte.ts",
        "test": "vitest run --project node --project browser",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "prepack": "cp ../../LICENSE LICENSE"
    },
    "devDependencies": {
        "@overlapmark/adapter-contract": "workspace:*",
        "@sveltejs/package": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7"
    }
}
