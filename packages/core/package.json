{
    "name": "@overlapmark/core",
    "version": "0.0.0",
    "description": "Framework-agnostic core for overlapping text highlights",
    "license": "MIT",
    "author": "Donghyun Lee",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./dom": {
            "import": {
                "types": "./dist/dom/index.d.ts",
                "default": "./dist/dom/index.js"
            },
            "require": {
                "types": "./dist/dom/index.d.cts",
                "default": "./dist/dom/index.cjs"
            }
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run --project node --project browser",
        "test:perf": "vitest run --project perf",
        "bench": "vitest bench --run --reporter=verbose",
        "typecheck": "tsc --noEmit"
    }
}
