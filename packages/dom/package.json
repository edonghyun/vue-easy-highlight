{
    "name": "@overlapmark/dom",
    "version": "0.0.0",
    "description": "Vanilla JS adapter for overlapping text highlights",
    "license": "MIT",
    "author": "Donghyun Lee",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/edonghyun/vue-easy-highlight.git",
        "directory": "packages/dom"
    },
    "homepage": "https://github.com/edonghyun/vue-easy-highlight#readme",
    "bugs": "https://github.com/edonghyun/vue-easy-highlight/issues",
    "keywords": [
        "highlight",
        "overlapping-highlights",
        "text-highlight",
        "annotation",
        "vanilla"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@overlapmark/core": "workspace:^"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "prepack": "cp ../../LICENSE LICENSE"
    },
    "devDependencies": {
        "@overlapmark/adapter-contract": "workspace:*"
    }
}
