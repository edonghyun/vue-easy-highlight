{
    "name": "@overlapmark/react",
    "version": "0.0.0",
    "description": "React component for overlapping text highlights",
    "license": "MIT",
    "author": "Donghyun Lee",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/edonghyun/overlapmark.git",
        "directory": "packages/react"
    },
    "homepage": "https://github.com/edonghyun/overlapmark#readme",
    "bugs": "https://github.com/edonghyun/overlapmark/issues",
    "keywords": [
        "highlight",
        "overlapping-highlights",
        "text-highlight",
        "annotation",
        "react"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@overlapmark/core": "workspace:^"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run --project node --project browser",
        "typecheck": "tsc --noEmit",
        "prepack": "cp ../../LICENSE LICENSE"
    },
    "devDependencies": {
        "@overlapmark/adapter-contract": "workspace:*",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
